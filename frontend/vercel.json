{
  "rewrites": [
    {
      "source": "/((?!api/|images/|assets/|monogram\\.svg$|photo-credits\\.html$|robots\\.txt$|catalogue-image-sources\\.txt$|first-edition-sources\\.txt$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
